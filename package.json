{
  "name": "jogo-de-luta-rpg",
  "private": true,
  "version": "3.7.0",
  "description": "RPG de combate por turnos em TypeScript, evoluído a partir do Jogo de Luta do curso de JavaScript da B7Web.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "node --experimental-strip-types --no-warnings scripts/simulate.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
